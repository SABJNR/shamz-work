<%- include('partials/header', { title: product.name }) %>

<%
  const isVerified = currentUser && !currentUser.is_admin && currentUser.email_verified === 1;
  const isSoldOut = product.stock !== null && product.stock !== undefined && product.stock <= 0;
%>

<div class="container">
  <div class="product-detail">
    <div class="thumb" style="background-image:url('<%= product.image_url %>')"></div>
    <div>
      <% if (isSoldOut) { %>
        <div class="status-line" style="color:var(--ink-dim);">Sold out</div>
      <% } else if (product.status === 'unreleased') { %>
        <div class="status-line"><%= product.allow_preorder ? 'Pre-order · Unreleased' : 'Preview only · Coming soon' %></div>
      <% } else { %>
        <div class="status-line">In stock<%= (product.stock !== null && product.stock !== undefined) ? ' · ' + product.stock + ' left' : '' %></div>
      <% } %>
      <h1><%= product.name %></h1>
      <div class="price"><%= formatPrice(product.price, product.currency) %></div>
      <p class="desc"><%= product.description %></p>

      <% if (isSoldOut) { %>
        <button class="btn btn-secondary btn-block" disabled>Sold out</button>
        <p class="helper-note">Check back later, or browse <a href="/" style="text-decoration:underline;">what's currently available</a>.</p>

      <% } else if (product.status === 'available' || (product.status === 'unreleased' && product.allow_preorder)) { %>
        <% const isPreorder = product.status === 'unreleased'; %>

        <% if (!currentUser) { %>
          <a href="/login?redirectTo=/product/<%= product.id %>" class="btn <%= isPreorder ? 'btn-ochre' : 'btn-primary' %> btn-block"><%= isPreorder ? 'Log in to pre-order' : 'Log in to add to cart' %></a>
          <p class="helper-note">New here? <a href="/signup?redirectTo=/product/<%= product.id %>" style="text-decoration:underline;">Create an account</a> — it only takes a minute.</p>

        <% } else if (!isVerified) { %>
          <div class="error-msg" style="background:#FFF4E5;color:#8A5A13;border-left-color:#8A5A13;">
            Please verify your email before <%= isPreorder ? 'pre-ordering' : 'adding items to your cart' %>.
          </div>
          <form method="POST" action="/resend-verification">
            <button type="submit" class="btn btn-secondary btn-block">Resend verification email</button>
          </form>

        <% } else { %>
          <form method="POST" action="/cart/add/<%= product.id %>">
            <div class="field" style="display:flex;justify-content:space-between;align-items:baseline;">
              <label style="margin:0;">Size</label>
              <a href="/size-guide" target="_blank" class="helper-note" style="text-decoration:underline;">📏 Size guide</a>
            </div>
            <select name="size">
              <% product.sizes.split(',').forEach(s => { %>
                <option value="<%= s.trim() %>"><%= s.trim() %></option>
              <% }) %>
            </select>
            <div class="field" style="margin-top:16px;">
              <label>Quantity</label>
              <input type="number" name="quantity" value="1" min="1" <%= (product.stock !== null && product.stock !== undefined) ? 'max="' + product.stock + '"' : '' %>>
            </div>
            <button type="submit" class="btn <%= isPreorder ? 'btn-ochre' : 'btn-primary' %> btn-block"><%= isPreorder ? 'Add pre-order to cart' : 'Add to cart' %></button>
            <p class="helper-note"><%= isPreorder ? "This is a pre-order for an unreleased piece — production and ship dates will be confirmed by email." : "You'll choose delivery and pay when you check out." %></p>
          </form>
        <% } %>

      <% } else { %>
        <!-- Unreleased, view-only: offer waitlist instead -->
        <% if (!currentUser) { %>
          <a href="/login?redirectTo=/product/<%= product.id %>" class="btn btn-secondary btn-block">Log in to join the waitlist</a>
        <% } else if (!isVerified) { %>
          <div class="error-msg" style="background:#FFF4E5;color:#8A5A13;border-left-color:#8A5A13;">Please verify your email to join the waitlist.</div>
          <form method="POST" action="/resend-verification">
            <button type="submit" class="btn btn-secondary btn-block">Resend verification email</button>
          </form>
        <% } else if (alreadyWaitlisted) { %>
          <button class="btn btn-secondary btn-block" disabled>You're on the waitlist ✓</button>
        <% } else { %>
          <form method="POST" action="/waitlist/<%= product.id %>">
            <button type="submit" class="btn btn-secondary btn-block">Notify me when it drops</button>
          </form>
        <% } %>
        <p class="helper-note">This piece hasn't been released for ordering yet — you can only preview it for now.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
