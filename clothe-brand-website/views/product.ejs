<%- include('partials/header', { title: product.name }) %>

<div class="container">
  <div class="product-detail">
    <div class="thumb" style="background-image:url('<%= product.image_url %>')"></div>
    <div>
      <% if (product.status === 'unreleased') { %>
        <div class="status-line"><%= product.allow_preorder ? 'Pre-order · Unreleased' : 'Preview only · Coming soon' %></div>
      <% } else { %>
        <div class="status-line">In stock</div>
      <% } %>
      <h1><%= product.name %></h1>
      <div class="price"><%= formatPrice(product.price, product.currency) %></div>
      <p class="desc"><%= product.description %></p>

      <% if (product.status === 'available') { %>
        <!-- Available now: order directly (account required) -->
        <form method="POST" action="/order/<%= product.id %>">
          <div class="field">
            <label>Size</label>
            <select name="size">
              <% product.sizes.split(',').forEach(s => { %>
                <option value="<%= s.trim() %>"><%= s.trim() %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label>Quantity</label>
            <input type="number" name="quantity" value="1" min="1">
          </div>
          <div class="field">
            <label>Shipping address</label>
            <textarea name="shipping_address" placeholder="Where should we deliver this?" required></textarea>
          </div>
          <div class="field">
            <label>Note (optional)</label>
            <textarea name="note" placeholder="Anything else we should know?"></textarea>
          </div>
          <% if (currentUser) { %>
            <button type="submit" class="btn btn-primary btn-block">Place order</button>
            <p class="helper-note">Payment isn't collected online yet — we'll reach out to confirm payment and delivery details.</p>
          <% } %>
        </form>
        <% if (!currentUser) { %>
          <a href="/login?redirectTo=/product/<%= product.id %>" class="btn btn-primary btn-block">Log in to order</a>
          <p class="helper-note">New here? <a href="/signup?redirectTo=/product/<%= product.id %>" style="text-decoration:underline;">Create an account</a> — it only takes a minute.</p>
        <% } %>

      <% } else if (product.allow_preorder) { %>
        <!-- Unreleased but pre-orders open -->
        <form method="POST" action="/order/<%= product.id %>">
          <div class="field">
            <label>Size</label>
            <select name="size">
              <% product.sizes.split(',').forEach(s => { %>
                <option value="<%= s.trim() %>"><%= s.trim() %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label>Quantity</label>
            <input type="number" name="quantity" value="1" min="1">
          </div>
          <div class="field">
            <label>Shipping address</label>
            <textarea name="shipping_address" placeholder="Where should we deliver this?" required></textarea>
          </div>
          <% if (currentUser) { %>
            <button type="submit" class="btn btn-ochre btn-block">Reserve with a pre-order</button>
            <p class="helper-note">This is a pre-order for an unreleased piece — production and ship dates will be confirmed by email.</p>
          <% } %>
        </form>
        <% if (!currentUser) { %>
          <a href="/login?redirectTo=/product/<%= product.id %>" class="btn btn-ochre btn-block">Log in to pre-order</a>
          <p class="helper-note">New here? <a href="/signup?redirectTo=/product/<%= product.id %>" style="text-decoration:underline;">Create an account</a> — it only takes a minute.</p>
        <% } %>

      <% } else { %>
        <!-- Unreleased, view-only: offer waitlist instead -->
        <% if (currentUser) { %>
          <% if (alreadyWaitlisted) { %>
            <button class="btn btn-secondary btn-block" disabled>You're on the waitlist ✓</button>
          <% } else { %>
            <form method="POST" action="/waitlist/<%= product.id %>">
              <button type="submit" class="btn btn-secondary btn-block">Notify me when it drops</button>
            </form>
          <% } %>
        <% } else { %>
          <a href="/login?redirectTo=/product/<%= product.id %>" class="btn btn-secondary btn-block">Log in to join the waitlist</a>
        <% } %>
        <p class="helper-note">This piece hasn't been released for ordering yet — you can only preview it for now.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
