<%- include('partials/header', { title: 'Size Guide' }) %>

<div class="container">
  <section class="section" style="max-width:700px;">
    <div class="section-head">
      <h2>Size guide</h2>
    </div>

    <p style="color:var(--ink-dim);margin-bottom:24px;">General fit guide for our shirts, tops, and hoodies. Measurements are in inches. If you're between sizes, we recommend sizing up for a relaxed fit.</p>

    <table>
      <thead>
        <tr><th>Size</th><th>Chest (in)</th><th>Length (in)</th><th>Sleeve (in)</th></tr>
      </thead>
      <tbody>
        <tr><td>S</td><td>36–38</td><td>27</td><td>8.5</td></tr>
        <tr><td>M</td><td>39–41</td><td>28</td><td>9</td></tr>
        <tr><td>L</td><td>42–44</td><td>29</td><td>9.5</td></tr>
        <tr><td>XL</td><td>45–47</td><td>30</td><td>10</td></tr>
        <tr><td>XXL</td><td>48–50</td><td>31</td><td>10.5</td></tr>
      </tbody>
    </table>

    <p class="helper-note" style="margin-top:20px;">Not sure which size to pick, or need measurements for a specific piece? <a href="/policies" style="text-decoration:underline;">Contact us</a> before you order and we'll help you get it right.</p>
  </section>
</div>

<%- include('partials/footer') %>
