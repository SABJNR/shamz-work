<%- include('partials/header', { title: 'My Orders' }) %>

<div class="container">
  <section class="section">
    <div class="section-head">
      <h2>My orders</h2>
    </div>
    <% if (orders.length === 0) { %>
      <div class="empty-state">You haven't placed any orders yet. <a href="/" style="text-decoration:underline;">Browse the shop</a>.</div>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Item</th><th>Type</th><th>Size</th><th>Qty</th><th>Status</th><th>Placed</th></tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><%= o.product_name %></td>
              <td><%= o.type === 'preorder' ? 'Pre-order' : 'Order' %></td>
              <td><%= o.size || '—' %></td>
              <td><%= o.quantity %></td>
              <td><span class="status-tag status-<%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
              <td><%= new Date(o.created_at).toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
