<%- include('partials/header', { title: 'My Orders' }) %>

<div class="container">
  <section class="section">
    <div class="section-head">
      <h2>My orders</h2>
    </div>
    <% if (orders.length === 0) { %>
      <div class="empty-state">You haven't placed any orders yet. <a href="/" style="text-decoration:underline;">Browse the shop</a>.</div>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Items</th><th>Type</th><th>Total</th><th>Status</th><th>Placed</th><th></th></tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td>
                <% o.items.forEach(item => { %>
                  <div><%= item.product_name %> <span style="color:var(--ink-dim);">(<%= item.size || '—' %> × <%= item.quantity %>)</span></div>
                <% }) %>
              </td>
              <td><%= o.type === 'preorder' ? 'Pre-order' : (o.type === 'mixed' ? 'Mixed' : 'Order') %></td>
              <td><%= formatPrice(o.amount_kobo, o.items[0].currency) %></td>
              <td><span class="status-tag status-<%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
              <td><%= new Date(o.created_at).toLocaleDateString() %></td>
              <td>
                <% if (o.status === 'pending_payment') { %>
                  <form method="POST" action="/pay/<%= o.id %>" style="display:inline;">
                    <button type="submit" class="btn btn-ochre btn-small">Pay now</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
