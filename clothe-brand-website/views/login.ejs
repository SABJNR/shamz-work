<%- include('partials/header', { title: 'Log in' }) %>

<div class="container">
  <div class="form-card">
    <h2>Welcome back</h2>
    <p class="helper-note" style="margin-top:0;margin-bottom:20px;">Log in to place your order.</p>
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <input type="hidden" name="redirectTo" value="<%= redirectTo %>">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required>
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>
    <p class="helper-note">No account yet? <a href="/signup?redirectTo=<%= encodeURIComponent(redirectTo) %>" style="text-decoration:underline;">Sign up</a></p>
  </div>
</div>

<%- include('partials/footer') %>
