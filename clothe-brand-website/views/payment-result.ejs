<%- include('partials/header', { title: 'Payment not completed' }) %>

<div class="container">
  <div class="form-card" style="text-align:center;">
    <h2>Payment didn't go through</h2>
    <% if (order) { %>
      <p>Your order for <strong><%= order.items.length === 1 ? order.items[0].product_name : order.items.length + ' items' %></strong> has been cancelled since payment wasn't completed.</p>
    <% } else { %>
      <p>We couldn't confirm this payment, so the order was cancelled.</p>
    <% } %>
    <p class="helper-note">If money left your account, don't worry — it'll be reversed automatically by your bank/Paystack within a few days. If you'd still like the item, you're welcome to place a fresh order.</p>
    <a href="/" class="btn btn-primary" style="margin-top:16px;">Back to shop</a>
    <br><br>
    <a href="/my-orders" style="text-decoration:underline;font-size:14px;">View my orders</a>
  </div>
</div>

<%- include('partials/footer') %>
