<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — F.D.C Clothing Store' : 'F.D.C Clothing Store' %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="brand">F.D.C<span> Clothing</span></a>
      <nav class="nav-links">
        <a href="/">Shop</a>
        <a href="/#unreleased">Coming Soon</a>
        <% if (currentUser) { %>
          <% if (currentUser.is_admin) { %>
            <a href="/admin">Admin Panel</a>
          <% } else { %>
            <a href="/cart">Cart<% if (cartCount > 0) { %> (<%= cartCount %>)<% } %></a>
            <a href="/my-orders">My Orders</a>
            <a href="/profile">My Profile</a>
          <% } %>
          <span>Hi, <%= currentUser.name.split(' ')[0] %></span>
          <form method="POST" action="/logout" style="display:inline">
            <button type="submit" class="pill" style="background:none;border:1px solid rgba(247,242,233,0.4);color:inherit;cursor:pointer;font:inherit;">Log out</button>
          </form>
        <% } else { %>
          <a href="/login" class="pill">Log in / Sign up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <% if (currentUser && !currentUser.is_admin && currentUser.email_verified !== 1) { %>
    <div style="background:#f3e4c9;color:#8a5a13;text-align:center;padding:10px 16px;font-size:13.5px;">
      Please verify your email to place orders.
      <form method="POST" action="/resend-verification" style="display:inline;">
        <button type="submit" style="background:none;border:none;text-decoration:underline;color:inherit;cursor:pointer;font:inherit;padding:0;">Resend verification email</button>
      </form>
    </div>
  <% } %>
