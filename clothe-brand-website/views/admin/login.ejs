<%- include('../partials/header', { title: 'Admin Login', currentUser: null }) %>

<div class="container">
  <div class="form-card">
    <h2>Admin login</h2>
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required>
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>
    <p class="helper-note">Default: admin@example.com / admin123 — change this after first login.</p>
  </div>
</div>

<%- include('../partials/footer') %>
