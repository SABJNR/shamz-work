<%- include('partials/header', { title: 'Checkout' }) %>

<div class="container">
  <section class="section" style="max-width:640px;">
    <div class="section-head">
      <h2>Checkout</h2>
    </div>

    <table style="margin-bottom:28px;">
      <thead><tr><th>Item</th><th>Size</th><th>Qty</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <td><%= item.product_name %></td>
            <td><%= item.size || '—' %></td>
            <td><%= item.quantity %></td>
            <td><%= formatPrice(item.line_total_kobo, item.currency) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <form method="POST" action="/checkout" id="checkoutForm">
      <div class="field">
        <label>How will you get your order?</label>
        <select name="delivery_method" id="deliveryMethod">
          <option value="delivery">Delivery</option>
          <option value="pickup">Pick up myself — <%= pickupLocation %> (free)</option>
        </select>
      </div>

      <div id="deliverySection">
        <div class="field">
          <label>Delivery zone</label>
          <select name="delivery_zone" id="deliveryZone">
            <% zones.forEach(z => { %>
              <option value="<%= z.key %>" data-fee="<%= z.feeKobo %>"><%= z.label %> — <%= formatPrice(z.feeKobo, items[0].currency) %></option>
            <% }) %>
          </select>
        </div>

        <div class="field" style="display:flex;justify-content:space-between;align-items:baseline;">
          <label style="margin:0;">Delivery address</label>
          <button type="button" id="useLocationBtn" class="helper-note" style="background:none;border:none;text-decoration:underline;cursor:pointer;padding:0;font-family:inherit;">📍 Use my current location</button>
        </div>
        <div class="field">
          <label>Street address</label>
          <input type="text" name="shipping_address" id="addrStreet" value="<%= profileUser && profileUser.address ? profileUser.address : '' %>" placeholder="House number, street name">
        </div>
        <div class="field">
          <label>City</label>
          <input type="text" name="shipping_city" id="addrCity" value="<%= profileUser && profileUser.city ? profileUser.city : '' %>">
        </div>
        <div class="field">
          <label>State</label>
          <input type="text" name="shipping_state" id="addrState" value="<%= profileUser && profileUser.state ? profileUser.state : '' %>">
        </div>
        <p id="locationStatus" class="helper-note" style="margin-top:-8px;margin-bottom:18px;"></p>
        <p class="helper-note" style="margin-top:-8px;margin-bottom:18px;"><a href="/profile" style="text-decoration:underline;">Update your saved address</a> to skip typing this next time.</p>
      </div>

      <div id="pickupSection" style="display:none;">
        <div class="error-msg" style="background:#FFF9E5;color:#8A6A0B;border-left-color:#B8860B;">
          You'll pick this up in person at: <strong><%= pickupLocation %></strong>. We'll email you when it's ready.
        </div>
      </div>

      <div class="field">
        <label>Delivery phone number</label>
        <input type="tel" name="shipping_phone" value="<%= profileUser && profileUser.phone ? profileUser.phone : '' %>" placeholder="So we/the courier can reach you" required>
      </div>

      <div class="field">
        <label>Note (optional)</label>
        <textarea name="note" placeholder="Anything else we should know?"></textarea>
      </div>

      <div class="field">
        <label>Promo code (optional)</label>
        <div style="display:flex;gap:8px;">
          <input type="text" name="promo_code" id="promoInput" style="text-transform:uppercase;flex:1;" placeholder="e.g. LAUNCH10">
          <button type="button" id="applyPromoBtn" class="btn btn-secondary btn-small" style="white-space:nowrap;">Apply</button>
        </div>
        <p id="promoStatus" class="helper-note" style="margin-top:8px;"></p>
      </div>

      <div class="field" style="border-top:1px solid var(--line);padding-top:16px;">
        <div style="display:flex;justify-content:space-between;font-size:14px;color:var(--ink-dim);margin-bottom:6px;">
          <span>Items total</span>
          <span id="itemTotalDisplay"><%= formatPrice(itemTotalKobo, items[0].currency) %></span>
        </div>
        <div id="discountRow" style="display:none;justify-content:space-between;font-size:14px;color:#1E7A3D;margin-bottom:6px;">
          <span>Discount</span>
          <span id="discountDisplay"></span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:14px;color:var(--ink-dim);margin-bottom:10px;">
          <span>Delivery fee</span>
          <span id="shipFeeDisplay"><%= formatPrice(zones[0].feeKobo, items[0].currency) %></span>
        </div>
        <div style="display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:18px;">
          <span>Total</span>
          <span id="totalDisplay"><%= formatPrice(itemTotalKobo + zones[0].feeKobo, items[0].currency) %></span>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block"><%= paystackEnabled ? 'Pay now' : 'Place order' %></button>
      <p class="helper-note"><%= paystackEnabled ? "You'll be taken to a secure payment page to complete your order." : "Payment isn't collected online yet — we'll reach out to confirm payment and delivery details." %></p>
    </form>

    <script>
      (function() {
        var itemTotalKobo = <%= itemTotalKobo %>;
        var currency = <%- JSON.stringify(items[0].currency) %>;
        function formatPrice(kobo) {
          var amount = (kobo / 100).toLocaleString('en-NG', { minimumFractionDigits: 2 });
          var symbol = currency === 'NGN' ? '₦' : currency + ' ';
          return symbol + amount;
        }

        var methodSelect = document.getElementById('deliveryMethod');
        var zoneSelect = document.getElementById('deliveryZone');
        var deliverySection = document.getElementById('deliverySection');
        var pickupSection = document.getElementById('pickupSection');
        var streetInput = document.getElementById('addrStreet');
        var cityInput = document.getElementById('addrCity');
        var stateInput = document.getElementById('addrState');

        function currentFee() {
          if (methodSelect.value === 'pickup') return 0;
          var opt = zoneSelect.options[zoneSelect.selectedIndex];
          return opt ? parseInt(opt.getAttribute('data-fee'), 10) || 0 : 0;
        }

        var appliedDiscountKobo = 0;

        function recalc() {
          var fee = currentFee();
          document.getElementById('shipFeeDisplay').textContent = formatPrice(fee);
          document.getElementById('itemTotalDisplay').textContent = formatPrice(itemTotalKobo);
          var total = Math.max(0, itemTotalKobo - appliedDiscountKobo) + fee;
          document.getElementById('totalDisplay').textContent = formatPrice(total);
          var discountRow = document.getElementById('discountRow');
          if (appliedDiscountKobo > 0) {
            discountRow.style.display = 'flex';
            document.getElementById('discountDisplay').textContent = '-' + formatPrice(appliedDiscountKobo);
          } else {
            discountRow.style.display = 'none';
          }
        }

        var promoBtn = document.getElementById('applyPromoBtn');
        var promoInput = document.getElementById('promoInput');
        var promoStatus = document.getElementById('promoStatus');
        promoBtn.addEventListener('click', function() {
          var code = promoInput.value.trim();
          if (!code) return;
          promoStatus.textContent = 'Checking…';
          promoStatus.style.color = '';
          fetch('/promo/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'code=' + encodeURIComponent(code)
          })
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.valid) {
                appliedDiscountKobo = data.discountKobo;
                promoStatus.textContent = 'Code applied ✓';
                promoStatus.style.color = '#1E7A3D';
              } else {
                appliedDiscountKobo = 0;
                promoStatus.textContent = data.reason || 'Invalid code.';
                promoStatus.style.color = '#A3162F';
              }
              recalc();
            })
            .catch(function() {
              promoStatus.textContent = "Couldn't check that code, try again.";
              promoStatus.style.color = '#A3162F';
            });
        });

        function toggleMethod() {
          var isPickup = methodSelect.value === 'pickup';
          deliverySection.style.display = isPickup ? 'none' : 'block';
          pickupSection.style.display = isPickup ? 'block' : 'none';
          [streetInput, cityInput, stateInput].forEach(function(el) {
            if (isPickup) { el.removeAttribute('required'); } else { el.setAttribute('required', 'required'); }
          });
          recalc();
        }

        methodSelect.addEventListener('change', toggleMethod);
        zoneSelect.addEventListener('change', recalc);
        toggleMethod();

        var btn = document.getElementById('useLocationBtn');
        var status = document.getElementById('locationStatus');
        btn.addEventListener('click', function() {
          if (!navigator.geolocation) {
            status.textContent = "Your browser doesn't support location detection — please type your address.";
            status.style.color = '#ff8a9a';
            return;
          }
          btn.disabled = true;
          var originalText = btn.textContent;
          btn.textContent = '📍 Detecting…';
          status.textContent = 'Waiting for location permission — check for a browser prompt.';
          status.style.color = '';

          function done() {
            btn.disabled = false;
            btn.textContent = originalText;
          }

          navigator.geolocation.getCurrentPosition(function(pos) {
            var lat = pos.coords.latitude, lon = pos.coords.longitude;
            status.textContent = 'Looking up your address…';
            fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=' + lat + '&lon=' + lon)
              .then(function(r) { return r.json(); })
              .then(function(data) {
                var a = data.address || {};
                var street = [a.house_number, a.road].filter(Boolean).join(' ') || a.neighbourhood || '';
                var city = a.city || a.town || a.village || a.county || '';
                var state = a.state || '';
                if (street) document.getElementById('addrStreet').value = street;
                if (city) document.getElementById('addrCity').value = city;
                if (state) document.getElementById('addrState').value = state;
                status.textContent = 'Location filled in — please double-check it looks right.';
                done();
              })
              .catch(function() {
                status.textContent = "Couldn't look up your address. Please type it in manually.";
                status.style.color = '#ff8a9a';
                done();
              });
          }, function(err) {
            if (err && err.code === 1) {
              status.textContent = 'Location access denied — please type your address manually.';
            } else if (err && err.code === 3) {
              status.textContent = 'Location request timed out — please type your address manually.';
            } else {
              status.textContent = "Couldn't get your location — please type your address manually.";
            }
            status.style.color = '#ff8a9a';
            done();
          }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 });
        });
      })();
    </script>
  </section>
</div>

<%- include('partials/footer') %>
