SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000

# REQUIRED: your MongoDB Atlas connection string (free tier is fine).
# This is what makes products/orders/customers persist permanently instead
# of resetting every time the app restarts or redeploys. See README for the
# step-by-step Atlas setup.
# Looks like: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/shamz
MONGODB_URI=

# Optional but recommended: used to send real verification emails via Brevo.
# Get these from https://app.brevo.com (free account, no card needed):
#   1. Sign up
#   2. Settings -> Senders & IP -> add & verify a sender email (e.g. your Gmail)
#   3. Settings -> SMTP & API -> API Keys -> generate a new key
# If left blank, the app just logs "would have sent" to the console instead
# of actually emailing anyone — handy for local development.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Shamz Clothing Store

# Optional but recommended: used to store product images permanently when
# the admin uploads a file (instead of pasting an image URL). Get these from
# https://cloudinary.com (free account, no card needed) -> Dashboard.
# If left blank, direct file upload is disabled and the admin form only
# accepts image URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: the public URL of your deployed site, used to build the link
# inside verification emails (e.g. https://firstdivisioncartel.onrender.com).
# If left blank, the app guesses it from the incoming request, which usually
# works fine too.
APP_BASE_URL=

# Optional but needed for real payments: your Paystack secret key.
# Get it from https://dashboard.paystack.com -> Settings -> API Keys & Webhooks.
# Use the TEST secret key while developing (starts with sk_test_), and only
# switch to the LIVE key (sk_live_) once you're ready to accept real money.
# Until this is set, orders fall back to "pay on contact" -- the order still
# gets recorded, but no online payment is collected.
PAYSTACK_SECRET_KEY=

# Optional: delivery fees by zone, in kobo. Defaults shown below match what's
# built in if you don't set these. Customers also have a free "pick up
# myself" option (see PICKUP_LOCATION).
ZONE_LAGOS_MAINLAND_KOBO=500000
ZONE_LAGOS_ISLAND_KOBO=700000
ZONE_PORT_HARCOURT_KOBO=700000
ZONE_ABUJA_KOBO=1000000
ZONE_OTHER_KOBO=700000

# Optional: shown to customers who choose the free "pick up myself" option.
PICKUP_LOCATION=Omole Phase 1, Lagos

# Optional: where "new order" notification emails get sent. Falls back to
# BREVO_SENDER_EMAIL if not set.
ADMIN_NOTIFICATION_EMAIL=

# Optional: shown on the /policies page as your customer service contact.
# Falls back to BREVO_SENDER_EMAIL if not set.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Optional: shows a floating WhatsApp chat button site-wide. Digits only,
# with country code, no leading 0/+/spaces (e.g. Nigerian 0813... becomes
# 234813...).
# Optional: shows a floating WhatsApp chat button site-wide.
# For ONE number, digits only, with country code, no leading 0/+/spaces:
WHATSAPP_NUMBER=

# For TWO OR MORE numbers, use this instead (WHATSAPP_NUMBERS takes priority
# over WHATSAPP_NUMBER above if both are set). The button becomes a small
# menu letting the customer pick who to message:
# WHATSAPP_NUMBERS=Sales:2348137165157,Support:2348123456789

# Optional: default image shown when a page link (other than a product page)
# is shared on WhatsApp/Instagram/etc. Product pages use the product's own
# photo automatically.
OG_DEFAULT_IMAGE=
